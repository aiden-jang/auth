{
  "name": "platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for aidenjang's apps (auth, owewell, bloomnote, is-it-a-dog) and shared packages, on Cloudflare.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "dev:owewell": "pnpm --filter @owewell/web dev"
  },
  "devDependencies": {
    "@aidenjang/config": "workspace:*",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
