{
  "name": "auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auth service (accounts.aidenjang.com) + the published @aidenjang/auth-client SDK and shared config, on Cloudflare.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "deploy": "pnpm verify && pnpm deploy:only",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm lint && pnpm knip && pnpm comments && pnpm format:check && pnpm build && pnpm -r test && pnpm --filter @aidenjang/auth-web e2e",
    "deploy:only": "pnpm --filter @aidenjang/auth-api run deploy",
    "knip": "knip",
    "comments": "node scripts/check-comments.mjs"
  },
  "devDependencies": {
    "@aidenjang/config": "workspace:*",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.34.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
