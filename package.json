{
  "name": "auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auth service (accounts.aidenjang.com) + the published @aidenjang/auth-client SDK and shared config, on Cloudflare.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "deploy": "pnpm verify && pnpm deploy:only",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm -r test",
    "deploy:only": "pnpm --filter @aidenjang/auth-api run deploy"
  },
  "devDependencies": {
    "@aidenjang/config": "workspace:*",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
