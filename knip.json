{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["cloudflare"],
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/api": {
      "entry": ["src/**/*.test.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/web": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts"]
    },
    "packages/client": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "project": ["**/*.js"]
    }
  }
}
