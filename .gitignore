# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example
# Holds no secret: it switches Turnstile off for the browser suite, and CI needs it to do that.
!.env.e2e
# Wrangler local secrets (never commit — these hold API keys for `wrangler dev`)
.dev.vars
.dev.vars.*

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/

# Prisma
packages/server/prisma/*.db

# Wrangler local state (miniflare D1/DO/KV)
.wrangler/

# Playwright run artifacts
test-results/
playwright-report/
