{
  "name": "@aidenjang/auth-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared identity service: register/login/session for every app.",
  "scripts": {
    "dev": "wrangler dev --var APP_URL:http://localhost:34110",
    "deploy": "pnpm --filter @aidenjang/auth-web build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply aidenjang-identity --local"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aidenjang/config": "workspace:*",
    "@cloudflare/vitest-pool-workers": "0.8.24",
    "@cloudflare/workers-types": "^4.20241230.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10",
    "wrangler": "^3.99.0"
  }
}
