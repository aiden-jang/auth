{
  "name": "@aidenjang/auth-client",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared client: validate the platform session against the auth service; build login URLs.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aidenjang/config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
