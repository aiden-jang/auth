{
  "name": "@bloomnote/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "bloomnote API on Cloudflare Workers (Hono + KV garden store, serves the SPA).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm --filter @bloomnote/web build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aidenjang/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
