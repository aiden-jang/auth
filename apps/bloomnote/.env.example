# bloomnote secrets. These are Cloudflare Worker values, not a runtime .env:
#   - local dev: put them in apps/bloomnote/api/.dev.vars (gitignored)
#   - production: set with `wrangler secret put <NAME>` (see api/DEPLOY.md)
# AUTH_URL is a plain var in wrangler.toml (override locally with
# `--var AUTH_URL:http://localhost:34100`), not a secret. The garden store is a
# KV namespace bound in wrangler.toml — no Redis.

# Gemini API key for garden generation. Free key: https://aistudio.google.com/apikey
# Without it the composer still runs and exercises the SSE error path.
GEMINI_API_KEY=AIza...
