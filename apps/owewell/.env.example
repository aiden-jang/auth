# owewell secrets. Cloudflare Worker values, not a runtime .env:
#   - local dev: put them in apps/owewell/api/.dev.vars (gitignored)
#   - production: set with `wrangler secret put <NAME>` (see api/DEPLOY.md)
# AUTH_URL is a plain var in wrangler.toml (override locally with
# `--var AUTH_URL:http://localhost:34100`), not a secret. D1 + the GroupRoom
# Durable Object are bindings in wrangler.toml.

# Anthropic API key for receipt OCR (itemizing from a photo). Optional: without it
# the whole app works and you itemize by hand.
ANTHROPIC_API_KEY=
