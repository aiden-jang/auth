# ---- AI vision provider ----
# The ai-worker auto-selects a provider: if VISION_PROVIDER is set it wins;
# otherwise the first available API key is used; otherwise a mock provider
# (random guesses from a small vocabulary) so the app runs with no keys.

# Force a specific provider: "mock" | "openai" | "anthropic"
# VISION_PROVIDER=mock

# Supply ONE of these to use a real vision model (auto-detected):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Infrastructure ----
# REDIS_URL=redis://localhost:6379
# AI_WORKER_URL=http://localhost:8090

# ---- Word list (optional overrides; default ships in words.json) ----
# Inline comma-separated list takes priority:
# WORDS=cat,dog,tree,house
# ...or point at a JSON array file:
# WORDS_FILE=/path/to/words.json

# ---- Client (Vite) ----
# VITE_SERVER_URL=ws://localhost:8080
