# is-it-a-dog secrets, all on the ai-worker (the game-server needs none). Cloudflare
# Worker values, not a runtime .env:
#   - local dev: put them in apps/is-it-a-dog/packages/ai-worker/.dev.vars (gitignored)
#   - production: set with `wrangler secret put <NAME>` (see DEPLOY.md)
# All optional: with no key the ai-worker uses the mock provider and the game still
# plays end to end. AI_WORKER_URL (game-server → ai-worker) is a var in wrangler.toml.

# Vision model keys. Set either one; the worker auto-selects the first available.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional override: "mock" | "openai" | "anthropic" (set in wrangler.toml [vars]).
# VISION_PROVIDER=mock
