# auth service secrets. Cloudflare Worker values, not a runtime .env:
#   - local dev: put them in apps/auth/api/.dev.vars (gitignored)
#   - production: set with `wrangler secret put <NAME>` (see api/DEPLOY.md)
# Everything here is optional in dev: unset Turnstile skips the bot check, and an
# unset email key makes the verify/reset flows no-op. D1 + the RateLimiter Durable
# Object are bindings in wrangler.toml, not secrets.

# Turnstile secret for the sign-up bot check (https://dash.cloudflare.com → Turnstile).
TURNSTILE_SECRET=

# Resend API key for verification + password-reset emails (https://resend.com).
RESEND_API_KEY=

# Vars (set in wrangler.toml, listed here for reference — not secrets):
#   APP_URL       base URL of the auth UI, used in email links (e.g. https://accounts.aidenjang.com)
#   CORS_ORIGINS  comma-separated app origins allowed to call auth with credentials
