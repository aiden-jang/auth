{
  "name": "@aidenjang/auth-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared identity service: register/login/session for every app.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply aidenjang-identity --local"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@aidenjang/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20241230.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.6.2",
    "wrangler": "^3.99.0"
  }
}
