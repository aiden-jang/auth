# wherever secrets. Cloudflare Worker values, not a runtime .env:
#   - local dev: put them in apps/wherever/packages/worker/.dev.vars (gitignored)
#   - production: set with `wrangler secret put <NAME>` (see DEPLOY.md)
# D1 + the SessionRoom / RateLimiter Durable Objects are bindings in wrangler.toml.

# Foursquare Places API key for real restaurant data. Optional: without it the
# seeded mock deck keeps the app fully playable.
FOURSQUARE_API_KEY=

# Optional: force the source, "mock" | "foursquare" (set in wrangler.toml [vars]).
# RESTAURANT_SOURCE=foursquare
