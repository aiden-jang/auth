# Caddy fronts the API and gets a free Let's Encrypt certificate automatically.
# Requires: this domain's DNS A record points at the VM, and ports 80 + 443 are open.
# WebSocket upgrades (/ws) are proxied transparently.
#
# Optional: set an email for cert expiry notices by uncommenting the global block.
# {
#     email you@example.com
# }

api.aidenjang.com {
	reverse_proxy api:30000
}
